# Copy to .env and replace the placeholder values. Never commit .env.

# --- Postgres (used by docker compose) ---
POSTGRES_USER=tesla
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dhaka_tesla
POSTGRES_PORT=5432

# --- API ---
NODE_ENV=development
API_PORT=4000
LOG_LEVEL=info
DATABASE_URL=postgres://tesla:change-me@localhost:5432/dhaka_tesla
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_TTL_HOURS=12
# Reverse proxies in front of the API (0 locally, 1 behind Render / the Next.js proxy)
TRUST_PROXY=0
# Failed sign-in/sign-up attempts allowed per IP per 15 minutes
AUTH_RATE_LIMIT=20

# --- Seed ---
# Password given to every demo account (Nusrat, Rafiq, Shirin, Jashim).
SEED_PASSWORD=change-me-demo-password
